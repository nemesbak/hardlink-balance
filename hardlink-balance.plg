<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name       "hardlink-balance">
  <!ENTITY author     "nemes">
  <!ENTITY version    "2026.10.31c">
  <!ENTITY commit     "55820dd3cdfd8fc721fdb4eedb567268a536ee3d">
  <!ENTITY raw        "https://raw.githubusercontent.com/&github;/&commit;">
  <!ENTITY github     "nemesbak/hardlink-balance">
  <!ENTITY pluginURL  "https://raw.githubusercontent.com/&github;/main/hardlink-balance.plg">
  <!ENTITY pluginDir  "/usr/local/emhttp/plugins/&name;">
  <!ENTITY bootDir    "/boot/config/plugins/&name;">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  pluginURL="&pluginURL;"
  min="6.12"
  icon="/plugins/&name;/images/hardlink-balance.png"
  support="https://github.com/&github;/issues"
>

<CHANGES>
##2026.10.31c
- Parallel copies (Settings: Copies at once). Each disk takes part in one copy at a time; about 3x faster on arrays without parity.
- Stop also ends the processes rsync forks; the engine never mistakes its own copies for another tool's.
- Limit per run is now a hard cap: a folder that would overshoot it is left for the next run.

##2026.10.31b
- New WebGUI: disks against the target band with projected fill, live run panel, plan routes, safety checks, skipped folders, moves, history and log. Follows the Unraid theme.
- Settings on the page: shares to balance, disks to leave alone, tolerance, minimum size, limit per run, recent-folder age, free space kept on destination.
- Automatic runs (daily, weekly, monthly) and Unraid notifications.
- English and Spanish; follows the Unraid language or a language chosen in Settings.
- The Run button asks for confirmation; it is disabled while Mover, parity or another array copy is active.

##2026.10.31
- Safety: the copy and its new directory entries are flushed to disk (fsync) before the source is removed.
- Respects each share's included/excluded disks when choosing a destination.
- Leftover temp files from a crashed run are cleaned on every disk.
- Plugin files pinned to a commit and checked by MD5; cached on flash so offline boots work.
- Uninstall keeps your settings and run history.
- Log rotation, stricter CSRF check, pid-reuse safe lock.

##2026.10.30b
- Safety: groups are moved only if every hardlink was found (st_nlink check); no more half-moved groups.
- Safety: copy to a hidden temp file, publish with a no-clobber link; crashes leave no half files.
- Safety: skip folders touched recently (MIN_AGE_MIN, default 60), open for writing, or partial downloads (.!qB, .part).
- Safety: source re-verified (inode, link count, size, mtime, writers) right before deleting.
- Safety: refuses to run during Mover, parity check or unBALANCE; stop now aborts the copy in flight.
- Moves whole folders (season / movie), oldest first, instead of scattering single files.
- ZFS disks report whole-pool capacity; failed source deletions are counted and alerted.
- Optional settings in /boot/config/plugins/hardlink-balance/hardlink-balance.cfg (WEBHOOK, RUNS_DIR, MIN_AGE_MIN).

##2026.10.30
- Initial official release of Hardlink Balance for Unraid.
- Hardlink-safe balancer engine grouping files by physical inode (st_dev, st_ino).
- Prevents duplicate space usage between qBittorrent downloads and Radarr/Sonarr/Jellyfin libraries.
- Native interactive WebGUI dashboard integrated under Tools (Herramientas).
- Live disk utilization bars, target line, and source/destination/balanced indicators.
- Real-time progress tracking: transfer speed (MB/s), elapsed time, ETA.
- Hardlink preservation statistics card (number of groups and GB preserved).
- Configurable tolerance slider (±1% to ±10%), min file size filter, and transfer limit.
- Automatic permission enforcement: nobody:users (99:100) 775 to avoid Permission Denied in torrent clients.
- Fully compatible with XFS arrays and ZFS child datasets (e.g. /mnt/diskN/datos).
</CHANGES>

<!-- ── Step 1: Pre-install: create directories ────────────────────────────── -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &pluginDir;/scripts
mkdir -p &pluginDir;/images
mkdir -p &bootDir;/runs
</INLINE>
</FILE>

<!-- ── Step 2: Download plugin components (pinned commit + MD5, cached on flash) ── -->
<!-- A file already on the flash with the right MD5 is not downloaded again: boots work offline. -->
<FILE Name="&bootDir;/HardlinkBalance.page">
<URL>&raw;/HardlinkBalance.page</URL>
<MD5>841aa92d6703f51e686641bc901e1efe</MD5>
</FILE>

<FILE Name="&bootDir;/scripts/hardlink_balance.py">
<URL>&raw;/scripts/hardlink_balance.py</URL>
<MD5>bb3b55df02ff331f02170b8be1331a0b</MD5>
</FILE>

<FILE Name="&bootDir;/scripts/status.php">
<URL>&raw;/scripts/status.php</URL>
<MD5>e2de957595f66bf8af954a1ac8d3c0eb</MD5>
</FILE>

<FILE Name="&bootDir;/images/hardlink-balance.png">
<URL>&raw;/images/hardlink-balance.png</URL>
<MD5>c3314a42d1198c29d82617c204f35848</MD5>
</FILE>

<FILE Name="&bootDir;/images/hardlink-balance.svg">
<URL>&raw;/images/hardlink-balance.svg</URL>
<MD5>7e94c4b752d80ec4408268a53285579f</MD5>
</FILE>

<!-- ── Step 3: Post-install setup & flash backup ──────────────────────────── -->
<FILE Run="/bin/bash">
<INLINE>
cp &bootDir;/HardlinkBalance.page &pluginDir;/
cp &bootDir;/scripts/hardlink_balance.py &bootDir;/scripts/status.php &pluginDir;/scripts/
cp &bootDir;/images/hardlink-balance.png &bootDir;/images/hardlink-balance.svg &pluginDir;/images/
chmod 755 &pluginDir;/scripts/hardlink_balance.py
chmod 644 &pluginDir;/scripts/status.php &pluginDir;/HardlinkBalance.page &pluginDir;/images/*

# Default settings (kept on upgrade)
if [[ ! -f &bootDir;/hardlink-balance.cfg ]]; then
  echo '# Alertmanager-style webhook for end-of-run alerts (empty = off)' > &bootDir;/hardlink-balance.cfg
  echo 'WEBHOOK=""' >> &bootDir;/hardlink-balance.cfg
  echo '# Where run reports are stored' >> &bootDir;/hardlink-balance.cfg
  echo 'RUNS_DIR="&bootDir;/runs"' >> &bootDir;/hardlink-balance.cfg
  echo '# Skip folders modified or hardlinked in the last N minutes' >> &bootDir;/hardlink-balance.cfg
  echo 'MIN_AGE_MIN="60"' >> &bootDir;/hardlink-balance.cfg
fi

# Re-register automatic runs (cron lives in RAM, the schedule on flash)
if [[ -f &bootDir;/hardlink-balance.cron ]]; then /usr/local/sbin/update_cron; fi

echo ""
echo "-----------------------------------------------------------"
echo " &name; has been installed successfully!"
echo " Access it via: Tools → Hardlink Balance"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- ── Removal handler ────────────────────────────────────────────────────── -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Stop any running process
if [[ -f /tmp/hardlink_balance.lock ]]; then
    pid="$(cat /tmp/hardlink_balance.lock)"
    kill -TERM -- "-$(ps -o pgid= "$pid" | tr -d ' ')" 2>/dev/null || kill "$pid" 2>/dev/null
    rm -f /tmp/hardlink_balance.lock
fi

rm -f &bootDir;/hardlink-balance.cron
/usr/local/sbin/update_cron
rm -rf &pluginDir;
# Keep settings and run history; drop only the cached program files
rm -rf &bootDir;/scripts &bootDir;/images &bootDir;/HardlinkBalance.page
echo "&name; has been removed (settings kept in &bootDir;)."
</INLINE>
</FILE>

</PLUGIN>
