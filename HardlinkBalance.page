/* EquiLink — Unraid array balancer that keeps hardlinks together */
$var   = @parse_ini_file('/var/local/emhttp/var.ini') ?: [];
$csrf  = $var['csrf_token'] ?? '';
$theme = $display['theme'] ?? (@parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true)['display']['theme'] ?? 'white');
$dark  = in_array($theme, ['black', 'gray'], true);
// Language: the setting wins; "auto" follows Unraid's language (Settings > Display Settings)
$hlbCfg = @parse_ini_file('/boot/config/plugins/hardlink-balance/hardlink-balance.cfg') ?: [];
$uiLoc  = $locale ?? (@parse_ini_file('/boot/config/plugins/dynamix/dynamix.cfg', true)['display']['locale'] ?? '');
$lang   = $hlbCfg['LANGUAGE'] ?? 'auto';
if (!in_array($lang, ['en', 'es'], true)) $lang = strncmp((string)$uiLoc, 'es', 2) === 0 ? 'es' : 'en';
