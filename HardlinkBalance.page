      <input type="text" id="el-plan-search" class="el-search-input" placeholder="🔍 Search file, movie, series or folder..." oninput="filterPlanTable()">
      
      <div class="el-filter-chips">
        <span class="el-chip active" id="chip-all" onclick="setPlanFilter('all')">All (<span id="count-all">0</span>)</span>
        <span class="el-chip" id="chip-links" onclick="setPlanFilter('links')"><i class="fa fa-link"></i> Hardlinks Only (<span id="count-links">0</span>)</span>
        <span class="el-chip" id="chip-singles" onclick="setPlanFilter('singles')">Single Files (<span id="count-singles">0</span>)</span>
      </div>
    </div>

    <div class="el-table-container">
      <table class="el-table" id="el-plan-table">
        <thead>
          <tr>
            <th style="width:130px;">Route</th>
            <th>File Path</th>
            <th style="width:110px;">Size</th>
            <th style="width:140px;">Hardlink Status</th>
          </tr>
        </thead>
        <tbody id="el-plan-rows"></tbody>
      </table>
    </div>
  </div>

  <!-- Live Execution Console -->
  <div class="el-card">
    <div class="el-card-header">
      <h3><i class="fa fa-terminal"></i> Activity Log</h3>
      <div style="display:flex;gap:8px;">
        <button class="el-btn el-btn-clear" style="padding:3px 10px;font-size:11.5px;" onclick="copyLog()">
          <i class="fa fa-clipboard"></i> <span id="btn-copy-label">Copy Log</span>
        </button>
        <button class="el-btn el-btn-clear" style="padding:3px 10px;font-size:11.5px;" onclick="pollNow()">
          <i class="fa fa-refresh"></i> Refresh
        </button>
      </div>
    </div>
    <div class="el-console-wrap">
      <div id="el-console" class="el-console">Waiting for activity...</div>
    </div>
  </div>

</div>

<script>
const ENDPOINT   = '/plugins/hardlink-balance/scripts/status.php';
const CSRF_TOKEN = '<?=$csrf?>';
let pollTimer    = null;
let lastState    = 'idle';
let currentPlan  = [];
let activeFilter = 'all';

// Theme detection
function checkTheme() {
    const wrap = document.getElementById('el-wrap');
    const isDark = document.body.classList.contains('dark') || 
                   window.matchMedia('(prefers-color-scheme: dark)').matches ||
                   document.documentElement.getAttribute('data-theme') === 'dark';
    if (isDark) wrap.classList.add('el-dark');
    else wrap.classList.remove('el-dark');
}
checkTheme();

function fmtKB(kb) {
    if (!kb || kb <= 0) return '0 KB';
    if (kb >= 1024 * 1024 * 1024) return (kb / (1024*1024*1024)).toFixed(2) + ' TB';
    if (kb >= 1024 * 1024) return (kb / (1024*1024)).toFixed(2) + ' GB';
    if (kb >= 1024) return (kb / 1024).toFixed(1) + ' MB';
    return kb + ' KB';
}

function fmtSec(s) {
    if (!s || s <= 0) return '00:00:00';
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = Math.floor(s % 60);
    return [h, m, sec].map(v => v < 10 ? '0' + v : v).join(':');
}

function renderDisks(disks, targetPct, tol) {
    const tbody = document.getElementById('el-disk-rows');
    if (!disks || disks.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;">No disks found</td></tr>';
        return;
    }
    document.getElementById('el-target-val').textContent = targetPct + '%';
    document.getElementById('el-tol-val').textContent = tol;
    document.getElementById('el-disks-count').textContent = disks.length + ' Disks';

    let html = '';
    for (const d of disks) {
        let badgeClass = 'el-pill-bal';
        let badgeText  = 'BALANCED';
        let barColor   = '#0284c7';
        let deltaText  = '';

        if (d.role === 'source') {
            badgeClass = 'el-pill-source';
            badgeText  = 'SOURCE';
            barColor   = '#ef4444';
            if (d.delta_kb > 0) deltaText = `<span style="font-size:11px;color:#ef4444;margin-left:4px;">(↓ ${fmtKB(d.delta_kb)})</span>`;
        } else if (d.role === 'destination') {
            badgeClass = 'el-pill-dest';
            badgeText  = 'DEST';
            barColor   = '#10b981';
            if (d.delta_kb < 0) deltaText = `<span style="font-size:11px;color:#10b981;margin-left:4px;">(↑ ${fmtKB(Math.abs(d.delta_kb))})</span>`;
        }

        const fsBadge = d.fsType ? `<span class="el-pill el-pill-fs">${d.fsType}</span>` : '';

        html += `<tr>
            <td><b>${d.name}</b></td>
            <td>${fsBadge}</td>
            <td><span class="el-pill ${badgeClass}">${badgeText}</span> ${deltaText}</td>
            <td>
                <div class="el-bar-wrap">
                    <div class="el-bar-fill" style="width:${Math.min(100, d.pct)}%;background:${barColor};"></div>
                    <div class="el-bar-target-line" style="left:${targetPct}%;" title="Target: ${targetPct}%"></div>
                </div>
            </td>
            <td style="text-align:right;font-weight:700;">${d.pct}%</td>
            <td style="text-align:right;font-size:12px;">${fmtKB(d.used_kb)} / ${fmtKB(d.size_kb)}</td>
            <td style="text-align:right;font-size:12px;color:var(--el-text-muted);">${fmtKB(d.free_kb)}</td>
        </tr>`;
    }
    tbody.innerHTML = html;
}

function setPlanFilter(filter) {
    activeFilter = filter;
    document.querySelectorAll('.el-chip').forEach(c => c.classList.remove('active'));
    document.getElementById('chip-' + filter).classList.add('active');
    filterPlanTable();
}

function filterPlanTable() {
    const q = (document.getElementById('el-plan-search').value || '').toLowerCase().trim();
    const tbody = document.getElementById('el-plan-rows');

    let visible = 0;
    let html = '';

    for (const p of currentPlan) {
        // Chip filter
        if (activeFilter === 'links' && p.links <= 1) continue;
        if (activeFilter === 'singles' && p.links > 1) continue;

        // Search query filter
        if (q && !p.path.toLowerCase().includes(q) && !p.src_disk.toLowerCase().includes(q) && !p.dst_disk.toLowerCase().includes(q)) {
            continue;
        }

        visible++;
        const linkBadge = p.links > 1
            ? `<span class="el-pill el-pill-dest"><i class="fa fa-link"></i> ${p.links} links</span>`
            : `<span class="el-pill el-pill-bal">1 file</span>`;

        html += `<tr>
            <td><b>${p.src_disk}</b> <i class="fa fa-arrow-right" style="color:var(--el-text-muted);font-size:10px;"></i> <b>${p.dst_disk}</b></td>
            <td style="word-break:break-all;font-family:monospace;font-size:12px;">${escHtml(p.path)}</td>
            <td>${fmtKB(p.size_kb)}</td>
            <td>${linkBadge}</td>
        </tr>`;
    }

    if (visible === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--el-text-muted);padding:16px;">No planned moves match filter</td></tr>';
    } else {
        tbody.innerHTML = html;
    }
}

function renderPlan(plan, totalCount) {
    currentPlan = plan || [];
    const card = document.getElementById('el-plan-card');
    const label = document.getElementById('el-plan-total-items');

    if (!plan || plan.length === 0) {
        card.style.display = 'none';
        return;
    }
    card.style.display = 'block';
    label.textContent = `(Showing top ${plan.length} of ${totalCount || plan.length} planned moves)`;

    // Update chip counters
    const linksCount = plan.filter(p => p.links > 1).length;
    document.getElementById('count-all').textContent = plan.length;
    document.getElementById('count-links').textContent = linksCount;
    document.getElementById('count-singles').textContent = (plan.length - linksCount);

    filterPlanTable();
}

function renderLog(lines) {
    const box = document.getElementById('el-console');
    if (!lines || lines.length === 0) return;
    box.textContent = lines.join('\n');
    box.scrollTop = box.scrollHeight;
}

function copyLog() {
    const box = document.getElementById('el-console');
    navigator.clipboard.writeText(box.textContent).then(() => {
        const lbl = document.getElementById('btn-copy-label');
        lbl.textContent = 'Copied!';
        setTimeout(() => lbl.textContent = 'Copy Log', 1800);
    });
}

function showBanner(type, html) {
    const b = document.getElementById('el-banner');
    b.className = 'el-banner el-banner-' + type;
    b.innerHTML = html;
    b.style.display = 'flex';
}
function hideBanner() { document.getElementById('el-banner').style.display = 'none'; }

function escHtml(s) {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function applyPreset(tol, minSize, limitGb) {
    document.getElementById('el-tolerance').value = tol;
    document.getElementById('el-min-size').value = minSize;
    document.getElementById('el-limit-gb').value = limitGb;
    pollNow();
}

function setButtons(state) {
    const btnAn = document.getElementById('btn-analyze');
    const btnEx = document.getElementById('btn-execute');
    const btnSt = document.getElementById('btn-stop');
    const btnCl = document.getElementById('btn-clear');
    const spin  = document.getElementById('el-spinner');
    const spinT = document.getElementById('el-spinner-text');

    const running = (state === 'running' || state === 'starting' || state === 'planning');

    btnAn.disabled = running;
    btnEx.disabled = running;
    btnSt.disabled = !running;
    btnCl.style.display = (!running && state !== 'idle') ? 'inline-flex' : 'none';

    if (running) {
        spin.style.display = 'inline-block';
        spinT.textContent = state === 'planning' ? 'Analyzing array & grouping hardlinks...' : 'Balancing data in background...';
    } else {
        spin.style.display = 'none';
    }
}

function applyStatus(data) {
    const state = data.state || 'idle';
    lastState = state;
    setButtons(state);

    const tol = data.tolerance || parseInt(document.getElementById('el-tolerance').value);
    const targetPct = data.target_pct || 0;
    renderDisks(data.disks, targetPct, tol);
    renderLog(data.log);

    const statsCard  = document.getElementById('el-stats-card');
    const shieldBox  = document.getElementById('el-shield-box');
    const stats      = data.stats || {};

    if (state !== 'idle') {
        statsCard.style.display = 'block';
        const badge = document.getElementById('el-op-badge');
        badge.textContent = state.toUpperCase();
        badge.className = 'el-pill ' + (state === 'running' ? 'el-pill-source' : (state === 'completed' ? 'el-pill-dest' : 'el-pill-bal'));

        const totalKB = stats.bytes_total_kb || 0;
        const doneKB  = stats.bytes_done_kb  || 0;
        const pct = totalKB > 0 ? ((doneKB * 100) / totalKB).toFixed(1) : (state === 'completed' ? 100 : 0);

        document.getElementById('el-prog-pct').textContent = pct + '%';
        document.getElementById('el-prog-fill').style.width = pct + '%';

        document.getElementById('st-groups-done').textContent = stats.files_done || 0;
        document.getElementById('st-groups-total').textContent = `of ${stats.files_total || data.plan_count || 0} planned`;

        document.getElementById('st-bytes-done').textContent = fmtKB(doneKB);
        document.getElementById('st-bytes-total').textContent = `of ${fmtKB(totalKB)} total`;

        const multiGroups = stats.multi_linked_groups || 0;
        const multiKB     = stats.multi_linked_kb || 0;
        document.getElementById('st-links-groups').textContent = multiGroups;
        document.getElementById('st-links-size').textContent = `${fmtKB(multiKB)} preserved`;

        if (multiGroups > 0) {
            shieldBox.style.display = 'flex';
            document.getElementById('shield-links-groups').textContent = multiGroups;
            document.getElementById('shield-links-size').textContent   = fmtKB(multiKB);
            document.getElementById('shield-saved-size').textContent   = fmtKB(multiKB);
        } else {
            shieldBox.style.display = 'none';
        }

        const speedKbs = stats.rate_kbs || 0;
        document.getElementById('st-speed').textContent = speedKbs > 0 ? (speedKbs / 1024).toFixed(1) + ' MB/s' : '-- MB/s';

        document.getElementById('st-elapsed').textContent = fmtSec(data.elapsed_sec || 0);
        document.getElementById('st-eta').textContent = stats.eta_sec > 0 ? 'ETA: ' + fmtSec(stats.eta_sec) : (state === 'completed' ? 'Done' : 'ETA: --');

        document.getElementById('st-failed').textContent = stats.files_skipped || 0;

        const currWrap = document.getElementById('el-curr-file-wrap');
        const currFile = document.getElementById('el-curr-file');
        if (data.current_file) {
            currWrap.style.display = 'block';
            currFile.textContent = data.current_file;
        } else {
            currWrap.style.display = 'none';
        }

        renderPlan(data.plan, data.plan_count);

        if (state === 'planned') {
            showBanner('info', `<i class="fa fa-info-circle"></i> <b>Analysis Complete:</b> Found ${data.plan_count} groups (${fmtKB(totalKB)}). ${multiGroups} groups share hardlinks and will be replicated safely without duplication.`);
        } else if (state === 'completed') {
            showBanner('success', `<i class="fa fa-check-circle"></i> <b>Operation Completed:</b> Transferred ${fmtKB(doneKB)} across ${stats.files_done} groups with complete hardlink integrity.`);
        } else if (state === 'stopped') {
            showBanner('warn', `<i class="fa fa-exclamation-triangle"></i> <b>Stopped by User:</b> Balancing halted cleanly after current file group. No broken links.`);
        } else if (state === 'error') {
            showBanner('err', `<i class="fa fa-times-circle"></i> <b>Error:</b> ${escHtml(data.msg || 'An error occurred during execution')}`);
        } else {
            hideBanner();
        }
    } else {
        statsCard.style.display = 'none';
        shieldBox.style.display = 'none';
        document.getElementById('el-plan-card').style.display = 'none';
        hideBanner();
    }
}

function pollNow() {
    const tol = document.getElementById('el-tolerance').value;
    fetch(ENDPOINT + '?tolerance=' + tol)
        .then(r => r.json())
        .then(data => {
            applyStatus(data);
            const running = (data.state === 'running' || data.state === 'starting' || data.state === 'planning');
            if (running) {
                if (!pollTimer) pollTimer = setTimeout(pollNow, 1200);
            } else {
                if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
            }
        })
        .catch(err => console.error('Poll error:', err));
}

function startRun(isDryRun) {
    const tol = document.getElementById('el-tolerance').value;
    const minSize = document.getElementById('el-min-size').value;
    const limitGb = document.getElementById('el-limit-gb').value;

    const body = new URLSearchParams();
    body.append('csrf_token', CSRF_TOKEN);
    body.append('action', 'start');
    body.append('tolerance', tol);
    body.append('dry_run', isDryRun ? '1' : '');
    body.append('min_file_kb', minSize);
    body.append('limit_gb', limitGb);

    setButtons(isDryRun ? 'planning' : 'starting');

    fetch(ENDPOINT, { method: 'POST', body: body })
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                alert('Could not start: ' + (res.msg || 'Unknown error'));
            }
            pollNow();
        })
        .catch(err => {
            alert('Request error: ' + err);
            pollNow();
        });
}

function stopRun() {
    if (!confirm('Are you sure you want to stop balancing? The file group currently in flight will finish cleanly before halting.')) return;
    const body = new URLSearchParams();
    body.append('csrf_token', CSRF_TOKEN);
    body.append('action', 'stop');

    fetch(ENDPOINT, { method: 'POST', body: body })
        .then(r => r.json())
        .then(() => pollNow())
        .catch(err => console.error(err));
}

function clearResults() {
    const body = new URLSearchParams();
    body.append('csrf_token', CSRF_TOKEN);
    body.append('action', 'clear');

    fetch(ENDPOINT, { method: 'POST', body: body })
        .then(r => r.json())
        .then(() => pollNow())
        .catch(err => console.error(err));
}

// Initial fetch
pollNow();
</script>
</body>
</html>
