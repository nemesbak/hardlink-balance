          <div class="field" style="grid-column:span 2"><label for="s-hook">Webhook (optional)</label><input id="s-hook" type="url" placeholder="http://127.0.0.1:5678/webhook/alerts"><div class="hint">Alertmanager-style JSON, sent when a run ends with problems or moved data.</div></div>
        </div>
