<script>
const ENDPOINT = '/plugins/hardlink-balance/scripts/status.php';
let pollTimer = null;
let lastState = 'idle';

// Dark mode detection to match Unraid theme
function checkTheme() {
    const wrap = document.getElementById('hl-wrap');
    const isDark = document.body.classList.contains('dark') || 
                   window.matchMedia('(prefers-color-scheme: dark)').matches ||
                   document.documentElement.getAttribute('data-theme') === 'dark';
    if (isDark) {
        wrap.classList.add('hl-dark');
    } else {
        wrap.classList.remove('hl-dark');
    }
}
checkTheme();

function fmtKB(kb) {
    if (!kb || kb <= 0) return '0 KB';
    if (kb >= 1024 * 1024 * 1024) return (kb / (1024*1024*1024)).toFixed(2) + ' TB';
    if (kb >= 1024 * 1024) return (kb / (1024*1024)).toFixed(2) + ' GB';
    if (kb >= 1024) return (kb / 1024).toFixed(1) + ' MB';
    return kb + ' KB';
}

function fmtSec(s) {
    if (!s || s <= 0) return '00:00:00';
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = Math.floor(s % 60);
    return [h, m, sec].map(v => v < 10 ? '0' + v : v).join(':');
}

function renderDisks(disks, targetPct, tol) {
    const tbody = document.getElementById('hl-disk-rows');
    if (!disks || disks.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">No disks found</td></tr>';
        return;
    }
    document.getElementById('hl-target-val').textContent = targetPct + '%';
    document.getElementById('hl-tol-val').textContent = tol;

    let html = '';
    for (const d of disks) {
        let badgeClass = 'hl-badge-bal';
        let badgeText  = 'BALANCED';
        let barColor   = '#3b82f6';

        if (d.role === 'source') {
            badgeClass = 'hl-badge-source';
            badgeText  = 'SOURCE';
            barColor   = '#ef4444';
        } else if (d.role === 'destination') {
            badgeClass = 'hl-badge-dest';
            badgeText  = 'DEST';
            barColor   = '#10b981';
        }

        html += `<tr>
            <td><b>${d.name}</b></td>
            <td><span class="hl-badge ${badgeClass}">${badgeText}</span></td>
            <td>
                <div class="hl-bar-bg">
                    <div class="hl-bar-fill" style="width:${Math.min(100, d.pct)}%;background:${barColor};"></div>
                    <div class="hl-bar-target-line" style="left:${targetPct}%;" title="Target: ${targetPct}%"></div>
                </div>
            </td>
            <td style="text-align:right;font-weight:600;">${d.pct}%</td>
            <td style="text-align:right;font-size:12px;">${fmtKB(d.used_kb)} / ${fmtKB(d.size_kb)}</td>
            <td style="text-align:right;font-size:12px;color:var(--hl-text-muted);">${fmtKB(d.free_kb)}</td>
        </tr>`;
    }
    tbody.innerHTML = html;
}

function renderPlan(plan, totalCount) {
    const card = document.getElementById('hl-plan-card');
    const tbody = document.getElementById('hl-plan-rows');
    const label = document.getElementById('hl-plan-total-items');

    if (!plan || plan.length === 0) {
        card.style.display = 'none';
        return;
    }
    card.style.display = 'block';
    label.textContent = `(Showing top ${plan.length} of ${totalCount || plan.length} planned moves)`;

    let html = '';
    for (const p of plan) {
        const linkBadge = p.links > 1
            ? `<span class="hl-badge hl-badge-dest"><i class="fa fa-link"></i> ${p.links} links</span>`
            : `<span class="hl-badge hl-badge-bal">1 file</span>`;

        html += `<tr>
            <td><b>${p.src_disk}</b> <i class="fa fa-arrow-right" style="color:var(--hl-text-muted);font-size:10px;"></i> <b>${p.dst_disk}</b></td>
            <td style="word-break:break-all;font-family:monospace;font-size:12px;">${escHtml(p.path)}</td>
            <td>${fmtKB(p.size_kb)}</td>
            <td>${linkBadge}</td>
        </tr>`;
    }
    tbody.innerHTML = html;
}

function renderLog(lines) {
    const box = document.getElementById('hl-console');
    if (!lines || lines.length === 0) return;
    box.textContent = lines.join('\n');
    box.scrollTop = box.scrollHeight;
}

function showBanner(type, html) {
    const b = document.getElementById('hl-banner');
    b.className = 'hl-banner hl-banner-' + type;
    b.innerHTML = html;
    b.style.display = 'flex';
}

function hideBanner() {
    document.getElementById('hl-banner').style.display = 'none';
}

function escHtml(s) {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function setButtons(state) {
    const btnAn = document.getElementById('btn-analyze');
    const btnEx = document.getElementById('btn-execute');
    const btnSt = document.getElementById('btn-stop');
    const btnCl = document.getElementById('btn-clear');
    const spin  = document.getElementById('hl-running-spinner');
    const spinT = document.getElementById('hl-spinner-text');

    const running = (state === 'running' || state === 'starting' || state === 'planning');

    btnAn.disabled = running;
    btnEx.disabled = running;
    btnSt.disabled = !running;
    btnCl.style.display = (!running && state !== 'idle') ? 'inline-flex' : 'none';

    if (running) {
        spin.style.display = 'inline-block';
        spinT.textContent = state === 'planning' ? 'Analyzing files & calculating groups...' : 'Balancing array data...';
    } else {
        spin.style.display = 'none';
    }
}

function applyStatus(data) {
    const state = data.state || 'idle';
    lastState = state;
    setButtons(state);

    const tol = data.tolerance || parseInt(document.getElementById('hl-tolerance').value);
    const targetPct = data.target_pct || 0;
    renderDisks(data.disks, targetPct, tol);
    renderLog(data.log);

    const statsCard = document.getElementById('hl-stats-card');
    const stats = data.stats || {};

    if (state !== 'idle') {
        statsCard.style.display = 'block';
        const badge = document.getElementById('hl-op-badge');
        badge.textContent = state.toUpperCase();
        badge.className = 'hl-badge ' + (state === 'running' ? 'hl-badge-source' : (state === 'completed' ? 'hl-badge-dest' : 'hl-badge-bal'));

        const totalKB = stats.bytes_total_kb || 0;
        const doneKB  = stats.bytes_done_kb  || 0;
        const pct = totalKB > 0 ? ((doneKB * 100) / totalKB).toFixed(1) : (state === 'completed' ? 100 : 0);

        document.getElementById('hl-prog-pct').textContent = pct + '%';
        document.getElementById('hl-prog-fill').style.width = pct + '%';

        document.getElementById('st-groups-done').textContent = stats.files_done || 0;
        document.getElementById('st-groups-total').textContent = `of ${stats.files_total || data.plan_count || 0} planned`;

        document.getElementById('st-bytes-done').textContent = fmtKB(doneKB);
        document.getElementById('st-bytes-total').textContent = `of ${fmtKB(totalKB)} total`;

        document.getElementById('st-links-groups').textContent = stats.multi_linked_groups || 0;
        document.getElementById('st-links-size').textContent = `${fmtKB(stats.multi_linked_kb || 0)} preserved`;

        const speedKbs = stats.rate_kbs || 0;
        document.getElementById('st-speed').textContent = speedKbs > 0 ? (speedKbs / 1024).toFixed(1) + ' MB/s' : '-- MB/s';

        document.getElementById('st-elapsed').textContent = fmtSec(data.elapsed_sec || 0);
        document.getElementById('st-eta').textContent = stats.eta_sec > 0 ? 'ETA: ' + fmtSec(stats.eta_sec) : (state === 'completed' ? 'Done' : 'ETA: --');

        document.getElementById('st-failed').textContent = stats.files_skipped || 0;

        const currWrap = document.getElementById('hl-curr-file-wrap');
        const currFile = document.getElementById('hl-curr-file');
        if (data.current_file) {
            currWrap.style.display = 'block';
            currFile.textContent = data.current_file;
        } else {
            currWrap.style.display = 'none';
        }

        renderPlan(data.plan, data.plan_count);

        if (state === 'planned') {
            showBanner('info', `<i class="fa fa-info-circle"></i> <b>Analysis Complete:</b> Found ${data.plan_count} groups (${fmtKB(totalKB)}). Review the plan below and click "Balance Array" to execute.`);
        } else if (state === 'completed') {
            showBanner('success', `<i class="fa fa-check-circle"></i> <b>Operation Finished:</b> Transferred ${fmtKB(doneKB)} across ${stats.files_done} groups with full hardlink preservation.`);
        } else if (state === 'stopped') {
            showBanner('warn', `<i class="fa fa-exclamation-triangle"></i> <b>Stopped by user:</b> Execution halted cleanly. Zero partial or broken files created.`);
        } else if (state === 'error') {
            showBanner('err', `<i class="fa fa-times-circle"></i> <b>Error:</b> ${escHtml(data.msg || 'An error occurred during execution')}`);
        } else {
            hideBanner();
        }
    } else {
        statsCard.style.display = 'none';
        document.getElementById('hl-plan-card').style.display = 'none';
        hideBanner();
    }
}

function pollNow() {
    const tol = document.getElementById('hl-tolerance').value;
    fetch(ENDPOINT + '?tolerance=' + tol)
        .then(r => r.json())
        .then(data => {
            applyStatus(data);
            const running = (data.state === 'running' || data.state === 'starting' || data.state === 'planning');
            if (running) {
                if (!pollTimer) pollTimer = setTimeout(pollNow, 1200);
            } else {
                if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; }
            }
        })
        .catch(err => console.error('Poll error:', err));
}

function startRun(isDryRun) {
    const tol = document.getElementById('hl-tolerance').value;
    const minSize = document.getElementById('hl-min-size').value;
    const limitGb = document.getElementById('hl-limit-gb').value;

    const body = new URLSearchParams();
    body.append('action', 'start');
    body.append('tolerance', tol);
    body.append('dry_run', isDryRun ? '1' : '');
    body.append('min_file_kb', minSize);
    body.append('limit_gb', limitGb);

    setButtons(isDryRun ? 'planning' : 'starting');

    fetch(ENDPOINT, { method: 'POST', body: body })
        .then(r => r.json())
        .then(res => {
            if (!res.success) {
                alert('Could not start: ' + (res.msg || 'Unknown error'));
            }
            pollNow();
        })
        .catch(err => {
            alert('Request error: ' + err);
            pollNow();
        });
}

function stopRun() {
    if (!confirm('Are you sure you want to stop balancing? Ongoing group will safely finish before stopping.')) return;
    const body = new URLSearchParams();
    body.append('action', 'stop');

    fetch(ENDPOINT, { method: 'POST', body: body })
        .then(r => r.json())
        .then(() => pollNow())
        .catch(err => console.error(err));
}

function clearResults() {
    const body = new URLSearchParams();
    body.append('action', 'clear');

    fetch(ENDPOINT, { method: 'POST', body: body })
        .then(r => r.json())
        .then(() => pollNow())
        .catch(err => console.error(err));
}

// Initial fetch on page load
pollNow();
</script>
</body>
</html>
