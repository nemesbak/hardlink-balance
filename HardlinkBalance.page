          <div class="field"><label for="s-sched">Automatic runs</label><select id="s-sched"><option value="off">Off</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly (day 1)</option></select></div>
          <div class="field"><label for="s-hour">At</label><select id="s-hour"></select></div>
          <div class="field"><label for="s-dow">On</label><select id="s-dow"><option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option></select></div>
          <div class="field"><label>Notifications</label><label class="check" for="s-notify"><input id="s-notify" type="checkbox" checked> Unraid notification when a run ends</label></div>
          <div class="field" style="grid-column:span 3"><label for="s-hook">Webhook (optional)</label><input id="s-hook" type="url" placeholder="http://127.0.0.1:5678/webhook/alerts"><div class="hint">Alertmanager-style JSON, sent when a run ends with problems or moved data.</div></div>
        </div>
        <div class="sfoot">
          <span class="sub" id="hlb-save-msg">Saved to /boot/config/plugins/hardlink-balance/hardlink-balance.cfg</span>
          <button class="btn primary" type="button" id="hlb-save">Save settings</button>
        </div>
      </div>
    </details>
  </section>

  <section class="panel" aria-labelledby="h-hist">
    <div class="phead"><h2 id="h-hist">History</h2><span class="sub" id="hlb-runs-dir"></span></div>
    <div class="pbody" id="hlb-hist"></div>
  </section>

  <section class="panel">
    <details>
      <summary class="phead"><h2><span class="caret">▸</span> Log</h2><button class="btn" type="button" id="hlb-copy">Copy log</button></summary>
      <div class="pbody"><pre class="console" id="hlb-log">No log yet.</pre></div>
    </details>
  </section>
</div>

<script>
(function(){
const ENDPOINT='/plugins/hardlink-balance/scripts/status.php';
const CSRF=<?= json_encode($csrf) ?>;
const $=id=>document.getElementById(id);
let D=null, filter='all', settingsDirty=false, confirmTimer=null, rates=[];

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function fmtKB(kb){kb=+kb||0;const u=['KB','MB','GB','TB'];let i=0;while(kb>=1024&&i<3){kb/=1024;i++}return (i>=2?kb.toFixed(2):Math.round(kb))+' '+u[i]}
function fmtDur(s){s=Math.max(0,Math.round(s||0));const h=Math.floor(s/3600),m=Math.floor(s%3600/60);return h?`${h} h ${String(m).padStart(2,'0')}`:m?`${m} min`:`${s} s`}
const when=t=>t?new Date(t*1000).toLocaleString([], {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}):'–';
const SKIP={partial:'partial download (.!qB, .part…)',recent:'changed too recently',open_write:'open for writing',links_outside:'a link lives outside the scanned shares'};

function post(data){
  const b=new FormData(); b.append('csrf_token',CSRF); for(const k in data) b.append(k,data[k]);
  return fetch(ENDPOINT,{method:'POST',body:b}).then(r=>r.json());
}
function banner(type,msg){const b=$('hlb-banner'); if(!msg){b.hidden=true;return} b.className='banner '+type; b.textContent=msg; b.hidden=false}

/* ---------- render ---------- */
function roleOf(d,target,tol){ if(d.excluded) return 'off'; return d.pct>target+tol?'src':d.pct<target-tol?'dst':'ok' }

function renderDisks(){
  const disks=D.live_disks||[], target=D.live_target_pct, tol=+D.tolerance||2;
  if(!disks.length){$('hlb-disks').innerHTML='<div class="empty">No array disks are mounted. Start the array to see them.</div>';return}
  // Projected fill after the plan: snapshot the plan was made from + flows
  const delta={}; (D.flows||[]).forEach(f=>{delta[f.src]=(delta[f.src]||0)-f.size_kb; delta[f.dst]=(delta[f.dst]||0)+f.size_kb});
  const base={}; (D.disks||[]).forEach(d=>base[d.name]=d);
  const showPlan=['planned','running','planning'].includes(D.state) && D.flows;
  const pcts=disks.map(d=>d.pct); const lo=Math.max(0,Math.floor((Math.min(...pcts,target-tol)-8)/10)*10), hi=Math.min(100,Math.ceil((Math.max(...pcts,target+tol)+6)/10)*10);
  const X=p=>Math.max(0,Math.min(100,(p-lo)/(hi-lo)*100));
  let html='';
  for(const d of disks){
    const r=roleOf(d,target,tol);
    const lbl={src:['p-src','Source'],dst:['p-dst','Destination'],ok:['p-ok','In band'],off:['p-off','Excluded']}[r];
    const color={src:'var(--src)',dst:'var(--dst)',ok:'var(--ok)',off:'var(--off)'}[r];
    let after=null;
    if(showPlan && delta[d.name] && base[d.name]) after=(base[d.name].used_kb+delta[d.name])*100/base[d.name].size_kb;
    html+=`<div class="disk ${r==='off'?'excluded':''}">
      <div class="dname"><b>${esc(d.name)} <span class="pill ${lbl[0]}">${lbl[1]}</span></b><span>${esc(d.fsType)} · ${fmtKB(d.size_kb)}${d.temp?' · '+esc(d.temp):''}${d.spun_down?' · spun down':''}</span></div>
      <div class="bar" role="img" aria-label="${esc(d.name)} ${d.pct} percent full, target ${target}">
        <div class="band" style="left:${X(target-tol)}%;width:${X(target+tol)-X(target-tol)}%"></div>
        <div class="fill" style="width:${X(d.pct)}%;background:${color}"></div>
        ${after!==null?`<div class="ghost" style="width:${X(after)}%"></div>`:''}
        <div class="target" style="left:calc(${X(target)}% - 1px)"></div>
      </div>
      <div class="dstat"><b>${d.pct} %</b>${after!==null?` → ${Math.round(after)} %`:''}<br><span style="color:var(--muted)">${fmtKB(d.free_kb)} free</span></div>
    </div>`;
  }
  const ticks=[]; for(let v=lo; v<=hi; v+=(hi-lo>40?20:10)) ticks.push(v);
  html+=`<div class="axis"><div></div><div>${ticks.map(v=>`<span style="left:${X(v)}%">${v}%</span>`).join('')}</div><div></div></div>`;
  $('hlb-disks').innerHTML=html;

  const act=disks.filter(d=>!d.excluded);
  if(act.length){
    const a=act.reduce((m,d)=>d.pct>m.pct?d:m), b=act.reduce((m,d)=>d.pct<m.pct?d:m);
    $('k-spread').innerHTML=`${a.pct-b.pct}<small>pts</small>`; $('k-spread-d').textContent=`${a.name} ${a.pct} % · ${b.name} ${b.pct} %`;
    const s=act.filter(d=>roleOf(d,target,tol)==='src').length, t=act.filter(d=>roleOf(d,target,tol)==='dst').length;
    $('k-out').innerHTML=`${s+t}<small>/ ${act.length}</small>`; $('k-out-d').textContent=`${s} source · ${t} destination`;
  }
  $('k-target').innerHTML=`${target}<small>%</small>`; $('k-tol').textContent=tol;
}

function renderSummary(){
  const st=D.state, s=D.stats||{};
  const T={idle:'Idle',starting:'Starting',planning:'Planning',planned:'Plan ready',running:'Moving',completed:'Finished',stopped:'Stopped',error:'Error'};
  $('hlb-state').dataset.s=st; $('hlb-state-t').textContent=T[st]||st;
  let d='Ready. Simulate first to see what would move.';
  if(st==='planning') d=`Scanning ${D.current_disk||''} (${D.source_idx||1} of ${D.source_total||1} source disks)`;
  if(st==='planned') d=D.dry_run?'Simulation finished · nothing was moved':'Plan ready';
  if(st==='running') d=`Started ${when(D.started_at)} · ${fmtDur(D.elapsed_sec)} elapsed`;
  if(st==='completed') d=D.plan_count?`${fmtKB(s.bytes_done_kb)} moved · ${s.files_skipped||0} skipped`:(D.note||'Every disk is inside the band');
  if(st==='stopped') d=`Stopped after ${fmtKB(s.bytes_done_kb||0)} · sources untouched`;
  if(st==='error') d=D.msg||'The engine reported an error';
  $('hlb-state-d').textContent=d;
  const planned=s.bytes_total_kb||0;
  $('k-plan').innerHTML=planned?`${fmtKB(planned).replace(/ (\w+)$/,'<small>$1</small>')}`:'–';
  $('k-plan-d').textContent=planned?`${(D.plan_count||0).toLocaleString()} groups · ${fmtKB(s.multi_linked_kb||0)} hardlinked`:'run Simulate to plan';
  const busy=D.running;
  $('hlb-run').hidden=busy; $('hlb-plan').hidden=busy; $('hlb-stop').hidden=!busy;
  $('hlb-clear').hidden=busy||!['completed','stopped','planned','error'].includes(st);
  const g=D.guards||{}, block=g.parity||g.mover||g.rsync;
  $('hlb-run').disabled=!!block;
  if(block && !busy) banner('warn',`Run is paused: ${block}. Simulate still works.`);
  else if(st==='error') banner('err',D.msg||'Error');
  else if(st==='completed' && (s.files_skipped||0)>0) banner('warn',`${s.files_skipped} groups were skipped. The log says why; nothing was lost.`);
  else banner('',null);
}

function renderRun(){
  const st=D.state, s=D.stats||{}, el=$('hlb-runbox'), pill=$('hlb-run-pill');
  const set=(c,t)=>{pill.className='pill '+c; pill.textContent=t};
  if(st==='running'){
    const cur=D.current||{}; if(cur.rate_mbs) rates.push(cur.rate_mbs); rates=rates.slice(-30);
    set('p-warn','Moving');
    const rate=(s.rate_kbs||0)/1024, p=s.pct_done||0;
    const max=Math.max(...rates,1), pts=rates.map((v,i)=>`${(rates.length>1?i/(rates.length-1)*300:300).toFixed(1)},${(50-v/max*42).toFixed(1)}`).join(' ');
    const last=(pts.split(' ').pop()||'300,50').split(',');
    el.innerHTML=`<div class="big"><span class="kv num">${fmtKB(s.bytes_done_kb)}</span><span class="sub">of ${fmtKB(s.bytes_total_kb)} · ${Math.round(p)} %</span></div>
      <div class="prog" role="progressbar" aria-valuenow="${Math.round(p)}" aria-valuemin="0" aria-valuemax="100"><i style="width:${p}%"></i></div>
      <div class="sub num">Group ${(s.files_done||0)+(s.files_skipped||0)} of ${s.files_total||0} · ${s.files_skipped||0} skipped</div>
      <div class="minis">
        <div class="mini"><div class="eyebrow">Speed</div><div class="kv num">${Math.round(rate)}<small>MB/s</small></div></div>
        <div class="mini"><div class="eyebrow">Time left</div><div class="kv num">${s.eta_sec?fmtDur(s.eta_sec):'–'}</div></div>
        <div class="mini"><div class="eyebrow">Hardlinked groups</div><div class="kv num">${s.multi_linked_groups||0}</div></div>
      </div>
      ${rates.length>1?`<svg class="spark" viewBox="0 0 300 56" preserveAspectRatio="none" aria-label="Copy speed of recent groups"><line x1="0" y1="50" x2="300" y2="50" stroke="var(--line)"/><polygon points="0,50 ${pts} 300,50" fill="var(--band)"/><polyline points="${pts}" fill="none" stroke="var(--accent)" stroke-width="1.6" vector-effect="non-scaling-stroke"/><circle cx="${last[0]}" cy="${last[1]}" r="3" fill="var(--accent)"/></svg>`:''}
      ${cur.rel_path?`<div class="current"><span class="eyebrow">Copying now · ${esc(cur.src_disk)} → ${esc(cur.dst_disk)}${cur.n_paths>1?` · ${cur.n_paths} links`:''}</span>${esc(cur.rel_path)}</div>`:''}`;
    return;
  }
  rates=[];
  if(st==='planning'||st==='starting'){ set('p-warn','Planning'); el.innerHTML=`<div class="big"><span class="kv">Scanning…</span></div><p class="sub">Reading ${esc(D.current_disk||'the source disks')} and grouping files by inode. Large disks take a few seconds each.</p>`; return }
  if(st==='planned'){
    set('p-warn',D.dry_run?'Simulation':'Planned');
    const lim=+D.settings.LIMIT_GB||0, runs=lim?Math.ceil((s.bytes_total_kb||0)/1048576/lim):1;
    el.innerHTML=`<div class="big"><span class="kv num">${fmtKB(s.bytes_total_kb)}</span><span class="sub">in ${(D.plan_count||0).toLocaleString()} groups</span></div>
      <p class="sub">Nothing has moved yet. Press Run to apply this plan; every group is re-checked right before it moves.</p>
      <div class="minis"><div class="mini"><div class="eyebrow">Runs needed</div><div class="kv num">${runs}</div></div>
      <div class="mini"><div class="eyebrow">Hardlinked</div><div class="kv num">${s.bytes_total_kb?Math.round((s.multi_linked_kb||0)*100/s.bytes_total_kb):0} %</div></div>
      <div class="mini"><div class="eyebrow">Routes</div><div class="kv num">${(D.flows||[]).length}</div></div></div>`;
    return;
  }
  if(st==='completed'||st==='stopped'){
    set(st==='completed'?'p-ok':'p-warn',st==='completed'?'Finished':'Stopped');
    el.innerHTML=`<div class="big"><span class="kv num">${fmtKB(s.bytes_done_kb||0)}</span><span class="sub">moved in ${fmtDur(D.elapsed_sec)}</span></div>
      <div class="minis"><div class="mini"><div class="eyebrow">Groups moved</div><div class="kv num">${s.files_done||0}</div></div>
      <div class="mini"><div class="eyebrow">Skipped</div><div class="kv num">${s.files_skipped||0}</div></div>
      <div class="mini"><div class="eyebrow">Avg speed</div><div class="kv num">${Math.round((s.rate_kbs||0)/1024)}<small>MB/s</small></div></div></div>`;
    return;
  }
  set('p-off','Idle');
  const h=(D.history||[])[0], sc=D.settings.SCHEDULE;
  el.innerHTML=`<div class="big"><span class="kv">No run in progress</span></div>
    <p class="sub">${sc&&sc!=='off'?`Automatic runs: ${schedText(D.settings)}.`:'Automatic runs are off. You can turn them on in Settings.'}</p>
    ${h?`<div class="minis"><div class="mini"><div class="eyebrow">Last run</div><div class="kv num">${when(h.started_at).split(',')[0]}</div></div><div class="mini"><div class="eyebrow">Moved</div><div class="kv num">${fmtKB(h.moved_kb)}</div></div><div class="mini"><div class="eyebrow">Problems</div><div class="kv num">${h.partial||0}</div></div></div>`:''}`;
}

function renderFlows(){
  const f=D.flows||[], s=D.stats||{};
  if(!f.length){$('hlb-flows').innerHTML='<div class="empty">No plan yet. Simulate shows which disk sends data where.</div>';$('hlb-flow-tot').textContent='';$('hlb-comp').hidden=true;return}
  const max=Math.max(...f.map(x=>x.size_kb)), shown=f.slice(0,8);
  $('hlb-flows').innerHTML=shown.map(x=>`<div class="flow"><span class="from">${esc(x.src)}</span><div class="ftrack"><i style="width:${x.size_kb/max*100}%"></i></div><span class="to">${esc(x.dst)}</span><span class="num">${fmtKB(x.size_kb)}</span></div>`).join('')
    +(f.length>8?`<div class="sub">and ${f.length-8} smaller routes</div>`:'');
  $('hlb-flow-tot').textContent=`${f.length} routes · ${fmtKB(f.reduce((a,x)=>a+x.size_kb,0))}`;
  const tot=s.bytes_total_kb||1, ml=s.multi_linked_kb||0, pc=ml*100/tot;
  $('hlb-comp').hidden=false;
  $('hlb-split').innerHTML=`<i style="width:${pc}%;background:var(--accent)"></i><i style="width:${100-pc}%;background:var(--muted);opacity:.45"></i>`;
  $('hlb-split-l').innerHTML=`<span><i style="background:var(--accent)"></i>Hardlinked · ${fmtKB(ml)} · ${s.multi_linked_groups||0} groups</span><span><i style="background:var(--muted)"></i>Single files · ${fmtKB(tot-ml)} · ${(s.files_total||0)-(s.multi_linked_groups||0)} groups</span>`;
}

function renderGuards(){
  const g=D.guards||{}, cfg=D.settings, shares=(cfg.SHARES||'').split(',').filter(Boolean), xd=(cfg.EXCLUDE_DISKS||'').split(',').filter(Boolean);
  const row=(ok,t,d)=>`<div class="guard ${ok?'g-ok':'g-warn'}"><span class="ic">${ok?'✓':'!'}</span><div><b>${esc(t)}</b><span>${esc(d)}</span></div></div>`;
  $('hlb-guards').innerHTML=
    row(!g.mover,g.mover?'Mover is running':'Mover idle',g.mover?'runs wait until it finishes':'checked before and during runs')+
    row(!g.parity,g.parity?'Parity check running':'No parity operation',g.parity?'runs wait until it finishes':'parity check or rebuild')+
    row(!g.rsync,g.rsync?'Another copy is running':'No other array copy',g.rsync||'unBALANCE or any rsync between /mnt/disk*')+
    row(true,'Open files are skipped','anything open for writing (downloads, imports) stays put')+
    row(true,'Copy is on disk before delete','each copy and its folder are flushed (fsync) first')+
    row(true,shares.length?`Only ${shares.length} share${shares.length>1?'s':''}`:'All user shares',(shares.length?shares.join(', '):'system shares excluded')+(xd.length?` · leaving ${xd.join(', ')} alone`:''));
}

function renderSkipped(){
  const sk=D.skipped||{}, keys=Object.keys(SKIP);
  if(!D.flows && !Object.keys(sk).length){$('hlb-skipped').innerHTML='<div class="empty">Shown after a simulation or run.</div>';return}
  $('hlb-skipped').innerHTML=keys.map(k=>`<span class="chip"><b>${sk[k]||0}</b>${SKIP[k]}</span>`).join('');
}

function renderRows(){
  const plan=D.plan||[], q=$('hlb-q').value.toLowerCase().trim();
  $('hlb-plan-count').textContent=D.plan_count?`· showing ${Math.min(plan.length,D.plan_count)} of ${D.plan_count.toLocaleString()}`:'';
  const done=(D.stats?.files_done||0)+(D.stats?.files_skipped||0), recent={}; (D.recent||[]).forEach(r=>recent[r.index]=r.status);
  const st=D.state;
  const rows=plan.map((p,i)=>({p,i})).filter(({p})=>(filter==='all'||(filter==='links'?p.links>1:p.links<=1))&&(!q||(p.path+' '+p.src_disk+' '+p.dst_disk).toLowerCase().includes(q))).slice(0,300);
  if(!rows.length){$('hlb-rows').innerHTML=`<tr><td colspan="5" class="sub" style="text-align:center;padding:18px">${plan.length?'No moves match the filter':'No moves planned'}</td></tr>`;return}
  $('hlb-rows').innerHTML=rows.map(({p,i})=>{
    let s=['st-wait',st==='planned'?'Planned':'Queued'];
    if(st==='running'||st==='completed'||st==='stopped'){
      const r=recent[i];
      if(r==='ok'||(r===undefined&&i<done)) s=['st-done','Moved'];
      if(r==='skipped') s=['st-skip','Skipped']; if(r==='partial') s=['st-skip','On both disks'];
      if(st==='running'&&i===done) s=['st-run','Copying'];
    }
    return `<tr><td class="${s[0]}" style="white-space:nowrap;font-weight:600">${s[1]}</td><td class="path">${esc(p.path)}</td><td class="mono" style="white-space:nowrap">${esc(p.src_disk)} → ${esc(p.dst_disk)}</td><td class="r num">${fmtKB(p.size_kb)}</td><td class="r">${p.links>1?`<span class="pill p-dst">${p.links} links</span>`:'<span class="pill p-ok">single</span>'}</td></tr>`}).join('');
}

const DOW=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
function schedText(c){const h=String(c.SCHEDULE_HOUR).padStart(2,'0')+':00';return {daily:`every day at ${h}`,weekly:`every ${DOW[+c.SCHEDULE_DOW]} at ${h}`,monthly:`day 1 of each month at ${h}`}[c.SCHEDULE]||'off'}

function renderSettings(){
  const c=D.settings; $('hlb-sched-sum').textContent=c.SCHEDULE==='off'?'manual runs only':'automatic: '+schedText(c);
  if(settingsDirty) return;
  const sh=(c.SHARES||'').split(',').filter(Boolean), xd=(c.EXCLUDE_DISKS||'').split(',').filter(Boolean);
  $('hlb-shares').innerHTML=(D.shares||[]).map(s=>`<label class="check ${s.system?'sys':''}"><input type="checkbox" data-share="${esc(s.name)}" ${sh.includes(s.name)?'checked':''}> ${esc(s.name)}${s.system?' <span class="sub">system</span>':''}</label>`).join('')||'<span class="sub">No user shares found.</span>';
  $('hlb-xdisks').innerHTML=(D.live_disks||[]).map(d=>`<label class="check"><input type="checkbox" data-disk="${esc(d.name)}" ${xd.includes(d.name)?'checked':''}> ${esc(d.name)} <span class="sub">${esc(d.fsType)}</span></label>`).join('');
  $('s-tol').value=c.TOLERANCE; $('s-tol-v').textContent=`±${c.TOLERANCE} %`; $('s-min').value=c.MIN_SIZE_MB; $('s-lim').value=c.LIMIT_GB;
  const age=$('s-age'); if(![...age.options].some(o=>o.value===String(c.MIN_AGE_MIN))) age.add(new Option(`${c.MIN_AGE_MIN} minutes`,c.MIN_AGE_MIN)); age.value=String(c.MIN_AGE_MIN);
  $('s-head').value=c.HEADROOM_GB; $('s-sched').value=c.SCHEDULE; $('s-hour').value=c.SCHEDULE_HOUR; $('s-dow').value=c.SCHEDULE_DOW;
  $('s-notify').checked=(c.UNRAID_NOTIFY||'yes')==='yes'; $('s-hook').value=c.WEBHOOK||'';
  schedFields(); $('hlb-runs-dir').textContent='reports in '+c.RUNS_DIR;
}
function schedFields(){const v=$('s-sched').value; $('s-hour').disabled=v==='off'; $('s-dow').disabled=v!=='weekly'}

function renderHistory(){
  const h=D.history||[];
  if(!h.length){$('hlb-hist').innerHTML='<div class="empty">No runs yet. Each run that moves data saves a report here.</div>';return}
  $('hlb-hist').innerHTML=h.map(r=>{
    if(r.state==='done') r.state='completed';
    const pill=r.state==='completed'?(r.partial?['p-warn','check log']:['p-ok','completed']):['p-warn',esc(r.state)];
    return `<div class="hrow"><b class="mono">${when(r.started_at)}</b><span>${r.trigger==='scheduled'?'Automatic':r.trigger==='manual'?'Manual':esc(r.trigger)}${r.tolerance?` · ±${r.tolerance} %`:''} · ${fmtDur(r.elapsed_s)}</span><span class="num">${fmtKB(r.moved_kb)}</span><span class="num">${r.out_after!==null&&r.out_after!==undefined?r.out_after+' out of band':r.failed+' skipped'}</span><span class="pill ${pill[0]}" style="justify-self:end">${pill[1]}</span></div>`}).join('');
}

function render(){
  renderSummary(); renderDisks(); renderRun(); renderFlows(); renderGuards(); renderSkipped(); renderRows(); renderSettings(); renderHistory();
  const log=D.log||[]; if(log.length){const el=$('hlb-log'); const atEnd=el.scrollTop+el.clientHeight>=el.scrollHeight-20; el.textContent=log.join('\n'); if(atEnd) el.scrollTop=el.scrollHeight}
}

/* ---------- polling ---------- */
let timer=null;
function poll(){
  fetch(ENDPOINT+'?_='+Date.now()).then(r=>r.json()).then(d=>{D=d; render()}).catch(()=>banner('err','Lost contact with the server. Retrying…'))
    .finally(()=>{clearTimeout(timer); timer=setTimeout(poll,(D&&D.running)?2000:8000)});
}

/* ---------- actions ---------- */
function start(dry){
  post({action:'start',dry_run:dry?1:''}).then(r=>{ if(!r.success) banner('err',r.msg||'Could not start'); poll() });
}
$('hlb-plan').onclick=()=>start(true);
$('hlb-run').onclick=()=>{
  const b=$('hlb-run');
  if(!b.classList.contains('confirm')){
    b.classList.add('confirm'); b.textContent='Confirm: move data';
    confirmTimer=setTimeout(()=>{b.classList.remove('confirm'); b.textContent='Run'},5000); return;
  }
  clearTimeout(confirmTimer); b.classList.remove('confirm'); b.textContent='Run'; start(false);
};
$('hlb-stop').onclick=()=>post({action:'stop'}).then(poll);
$('hlb-clear').onclick=()=>post({action:'clear'}).then(poll);
document.querySelectorAll('#hlb .chipbtn').forEach(b=>b.onclick=()=>{filter=b.dataset.f;document.querySelectorAll('#hlb .chipbtn').forEach(x=>x.setAttribute('aria-pressed',x===b));if(D)renderRows()});
$('hlb-q').oninput=()=>D&&renderRows();
$('hlb-copy').onclick=e=>{e.preventDefault();const t=$('hlb-log').textContent;(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>{e.target.textContent='Copied'},()=>{const r=document.createRange();r.selectNodeContents($('hlb-log'));getSelection().removeAllRanges();getSelection().addRange(r)}).finally(()=>setTimeout(()=>e.target.textContent='Copy log',1500))};
for(let h=0;h<24;h++) $('s-hour').add(new Option(String(h).padStart(2,'0')+':00',h));
$('hlb-settings').addEventListener('input',e=>{settingsDirty=true; if(e.target.id==='s-tol') $('s-tol-v').textContent=`±${e.target.value} %`; if(e.target.id==='s-sched') schedFields()});
$('hlb-settings').addEventListener('change',()=>{settingsDirty=true; schedFields()});
$('hlb-save').onclick=()=>{
  const shares=[...document.querySelectorAll('#hlb-shares input:checked')].map(i=>i.dataset.share).join(',');
  const xd=[...document.querySelectorAll('#hlb-xdisks input:checked')].map(i=>i.dataset.disk).join(',');
  post({action:'save_settings',shares,exclude_disks:xd,tolerance:$('s-tol').value,min_size_mb:$('s-min').value,limit_gb:$('s-lim').value,
    min_age_min:$('s-age').value,headroom_gb:$('s-head').value,schedule:$('s-sched').value,schedule_hour:$('s-hour').value,
    schedule_dow:$('s-dow').value,unraid_notify:$('s-notify').checked?1:'',webhook:$('s-hook').value.trim()})
  .then(r=>{$('hlb-save-msg').textContent=r.success?'Saved. New runs use these settings.':(r.msg||'Could not save'); if(r.success){settingsDirty=false; poll()}});
};
poll();
})();
</script>
